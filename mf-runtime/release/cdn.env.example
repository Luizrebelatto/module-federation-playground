# Destino S3 + CloudFront dos manifestos e bundles do remote.
# Copie para release/cdn.env e preencha. O cdn.env real NÃO é commitado.

CDN_BUCKET=            # nome do bucket S3, ex: minha-cdn
CDN_URL=               # base pública via CloudFront, ex: https://d111111abcdef8.cloudfront.net/mf-runtime
CDN_PREFIX=mf-runtime  # prefixo (pasta) dentro do bucket
CDN_AWS_PROFILE=       # perfil da AWS CLI com escrita no prefixo
CDN_ACCOUNT_ID=        # conta AWS esperada (trava contra publicar na conta errada)
