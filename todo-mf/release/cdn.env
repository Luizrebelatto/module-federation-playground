# Destino dos manifestos (Fase 5) e, depois, dos bundles do remote (Fase 9).
# Nada aqui é segredo: as credenciais ficam no perfil da AWS CLI (`aws configure --profile todo-mf`).

# Nome do bucket S3 que está atrás do CloudFront.
CDN_BUCKET=todo-mf-cdn-luiz
# Tem que bater com CDN_BASE_URL em apps/host/release/manifest.ts.
CDN_URL=https://d2agf17ues9yij.cloudfront.net/todo-mf
CDN_PREFIX=todo-mf
CDN_AWS_PROFILE=todo-mf
# O script recusa publicar se o perfil estiver logado em outra conta.
CDN_ACCOUNT_ID=579184888463
